# 安卓 release 签名配置模板
#
# ⚠️ 这不是给 Gradle 读的文件 —— 它只是给你看的模板。
#    真正生效的是 android/keystore.properties（由 tools/create-keystore.ps1 自动生成，
#    并且已加入 .gitignore，不会进仓库）。
#
# storeFile 的路径相对于 android/app/ 目录。
#   例：../keystore/snowbreak-release.jks  →  android/keystore/snowbreak-release.jks

storeFile=../keystore/snowbreak-release.jks
storePassword=在这里填你的密码
keyAlias=snowbreak
keyPassword=在这里填你的密码
